# Generated by `cargo run -p compose-rust --bin codegen`. DO NOT EDIT.
#
# Where the Linux renderer finds the Host's functions when it is linked into the
# application as a static archive.
#
# The renderer and the Host are one executable then, so the Host's functions are referred
# to by name and the link resolves them, the way any two halves of one program refer to each
# other. Looking them up at run time instead reads the executable's dynamic symbol table,
# and a Rust executable puts nothing there unless a shared library beside it asks for it.
#
# The references are weak. The renderer module's own test executable links with no Host in
# it, and a weak reference that nothing defines is a null address rather than a failed
# link. The renderer then falls back to looking the name up, which is also what it does on
# every other platform.
package = dxc_host

# The declarations below exist to be referred to, not called from Kotlin: the renderer
# calls through the addresses with the signatures its own boundary code declares.
excludedFunctions = dioxus_compose_host_init dioxus_compose_host_dispatch_event dioxus_compose_host_render_frame dioxus_compose_host_release_batch dioxus_compose_host_shutdown

---

extern void dioxus_compose_host_init(void) __attribute__((weak));
extern void dioxus_compose_host_dispatch_event(void) __attribute__((weak));
extern void dioxus_compose_host_render_frame(void) __attribute__((weak));
extern void dioxus_compose_host_release_batch(void) __attribute__((weak));
extern void dioxus_compose_host_shutdown(void) __attribute__((weak));

static inline void* dxc_linked_host_function(const char* name) {
    if (__builtin_strcmp(name, "dioxus_compose_host_init") == 0) return (void*)&dioxus_compose_host_init;
    if (__builtin_strcmp(name, "dioxus_compose_host_dispatch_event") == 0) return (void*)&dioxus_compose_host_dispatch_event;
    if (__builtin_strcmp(name, "dioxus_compose_host_render_frame") == 0) return (void*)&dioxus_compose_host_render_frame;
    if (__builtin_strcmp(name, "dioxus_compose_host_release_batch") == 0) return (void*)&dioxus_compose_host_release_batch;
    if (__builtin_strcmp(name, "dioxus_compose_host_shutdown") == 0) return (void*)&dioxus_compose_host_shutdown;
    return 0;
}

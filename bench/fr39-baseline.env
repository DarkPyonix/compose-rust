# Where the performance comparison of the two authoring paths takes its Dioxus path from.
#
# The baseline is the rsx! versions of the samples gathered in one crate, with the Dioxus
# adapter they were written against and the compose-rust underneath it, all at fixed
# commits. None of them may move under the comparison, so they are pinned together, and
# changing anything here means measuring every scenario again.
#
# They live in dioxus-compose: the baseline crate at dioxus-compose/benches/dioxus-baseline/,
# the eleven samples it gathers at samples/native-widgets/<name>/, and the adapter at
# dioxus-compose/. That commit pins compose-rust 22822c130 (develop, PR #52), the last
# compose-rust commit that held the adapter and the baseline itself, so the Dioxus path
# measured is the one that was here when the comparison started.
#
# Read by bench/fetch-dioxus-baseline.sh, which fetches the pinned source into .scratch/.
FR39_BASELINE_REPO=https://github.com/DarkPyonix/dioxus-compose
FR39_BASELINE_REV=dd1af76bd67282100de20ea7ffe5843b50886869
# The baseline crate's directory inside that checkout.
FR39_BASELINE_PATH=dioxus-compose/benches/dioxus-baseline
# The adapter's directory inside that checkout. The baseline crate depends on it through
# the workspace.
FR39_BASELINE_ADAPTER_PATH=dioxus-compose

# The compose-rust commit the pinned dioxus-compose depends on, read from
# dioxus-compose/Cargo.toml at that rev. The fetch script checks that the two agree, so a
# new dioxus-compose rev that moved its compose-rust is not taken for the same baseline.
FR39_BASELINE_COMPOSE_RUST_REV=22822c130a8211de7f65e0320db5e6a4db1a8bb1

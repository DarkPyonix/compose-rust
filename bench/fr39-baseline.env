# Where the performance comparison of the two authoring paths takes its Dioxus path from.
#
# The baseline is the rsx! versions of the samples gathered in one crate, with the Dioxus
# adapter they were written against, both at one fixed commit. Neither half may move
# under the comparison, so they are pinned together, and changing anything here means
# measuring every scenario again.
#
# They are no longer in this repository: the adapter, the baseline crate and the samples
# moved to dioxus-compose. Until dioxus-compose has a commit holding
# benches/dioxus-baseline/ (with the samples under samples/native-widgets/<name>/), the pin
# is the last compose-rust commit that held them, 22822c130 (develop, PR #52). It holds
# the same baseline and adapter sources as b18bdfe, the rev the harness on
# feature/compose-api pinned first: the commits between them change tests only.
#
# Read by bench/fetch-dioxus-baseline.sh, which fetches the pinned source into .scratch/.
FR39_BASELINE_REPO=https://github.com/DarkPyonix/compose-rust
FR39_BASELINE_REV=22822c130a8211de7f65e0320db5e6a4db1a8bb1
# The baseline crate's directory inside that checkout.
FR39_BASELINE_PATH=bench/dioxus-baseline
# The adapter's directory inside that checkout. The baseline crate names it by path.
FR39_BASELINE_ADAPTER_PATH=adapters/dioxus

# Where it goes once dioxus-compose holds it. Moving the pin there is a new baseline and a
# full re-measurement, the same as any other change to the lines above.
FR39_BASELINE_NEXT_REPO=https://github.com/DarkPyonix/dioxus-compose
FR39_BASELINE_NEXT_PATH=benches/dioxus-baseline

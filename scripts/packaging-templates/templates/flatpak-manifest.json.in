{
  "id": "{{identifier}}",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "{{runtime_version}}",
  "sdk": "org.freedesktop.Sdk",
  "command": "{{executable}}",
  "finish-args": [
    "--share=ipc",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "{{executable}}",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/lib/{{executable}} /app/bin",
        "test -x /app/lib/{{executable}}/{{executable}}",
        "ln -s ../lib/{{executable}}/{{executable}} /app/bin/{{executable}}",
        "install -Dm644 packaging/{{identifier}}.desktop /app/share/applications/{{identifier}}.desktop",
        "install -Dm644 packaging/{{identifier}}.metainfo.xml /app/share/metainfo/{{identifier}}.metainfo.xml"
      ],
      "sources": [
        { "type": "file", "path": "{{identifier}}.desktop", "dest": "packaging" },
        { "type": "file", "path": "{{identifier}}.metainfo.xml", "dest": "packaging" }
      ]
    }
  ]
}
